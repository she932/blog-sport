---
import { SITE, CATEGORIES } from '../consts';
import { AFFILIATE_DISCLOSURE } from '../lib/affiliate';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <div class="brand"><span aria-hidden="true">💪</span> {SITE.title}</div>
      <p class="muted">{SITE.description}</p>
    </div>
    <div>
      <h4>Catégories</h4>
      <ul>
        {CATEGORIES.map((c) => (
          <li><a href={`${base}/categorie/${c.slug}`}>{c.name}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h4>Le blog</h4>
      <ul>
        <li><a href={`${base}/blog`}>Tous les articles</a></li>
        <li><a href={`${base}/a-propos`}>À propos</a></li>
        <li><a href={`${base}/rss.xml`}>Flux RSS</a></li>
      </ul>
    </div>
    <div>
      <h4>Légal</h4>
      <ul>
        <li><a href={`${base}/mentions-legales`}>Mentions légales</a></li>
        <li><a href={`${base}/politique-confidentialite`}>Politique de confidentialité</a></li>
      </ul>
    </div>
  </div>
  <div class="container disclosure">
    <p>{AFFILIATE_DISCLOSURE}</p>
    <p class="muted">© {year} {SITE.title}. Tous droits réservés.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 5rem;
    background: var(--mg-navy);
    color: var(--mg-white);
    padding: 3.5rem 0 1.75rem;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 2rem;
  }
  .footer-grid h4 {
    margin: 0 0 0.9rem;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--mg-orange);
    font-weight: 700;
  }
  .footer-grid ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }
  .footer-grid a {
    color: rgba(255, 255, 255, 0.82);
    font-size: 0.95rem;
    transition: color 0.15s ease;
  }
  .footer-grid a:hover {
    color: var(--mg-orange);
    text-decoration: none;
  }
  .brand {
    font-weight: 800;
    font-size: 1.2rem;
    margin-bottom: 0.7rem;
    color: var(--mg-white);
  }
  .muted {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.9rem;
    line-height: 1.6;
  }
  .disclosure {
    margin-top: 2.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.55);
  }
  .disclosure p {
    margin: 0 0 0.5rem;
  }
  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem 2rem;
    }
  }
  @media (max-width: 520px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
