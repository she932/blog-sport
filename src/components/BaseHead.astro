---
import { SITE } from '../consts';

interface Props {
  title: string;
  description: string;
  /** Type Open Graph : 'website' pour les listes, 'article' pour les posts. */
  type?: 'website' | 'article';
  image?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  /** Bloc(s) JSON-LD supplémentaires (Article, FAQPage, BreadcrumbList...). */
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title,
  description,
  type = 'website',
  image,
  publishedTime,
  modifiedTime,
  jsonLd = [],
  noindex = false,
} = Astro.props;

// Base normalisé (sans slash final) : donne '' à la racine ('/') et
// '/sous-dossier' sinon, ce qui évite les doubles slashes dans les URLs.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(
  image ?? `${base}/og-default.svg`,
  Astro.site
);
// Titre SEO : on ajoute la marque en suffixe uniquement si le titre ne la
// contient pas déjà (accueil) ET si l'ensemble reste sous ~60 caractères,
// afin d'éviter la troncature dans les résultats de recherche.
const withBrand = `${title} | ${SITE.title}`;
const fullTitle = title.includes(SITE.title)
  ? title
  : withBrand.length <= 60
    ? withBrand
    : title;
---

<!-- Global -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
<link rel="sitemap" href={`${base}/sitemap-index.xml`} />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE.title}
  href={new URL(`${base}/rss.xml`, Astro.site)}
/>

<!-- Primary meta -->
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
<meta name="author" content={SITE.author} />
<link rel="canonical" href={canonicalURL} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImage} />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:locale" content={SITE.locale} />
{publishedTime && (
  <meta property="article:published_time" content={publishedTime.toISOString()} />
)}
{modifiedTime && (
  <meta property="article:modified_time" content={modifiedTime.toISOString()} />
)}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />

<!-- Données structurées -->
{jsonLd.map((block) => (
  <script type="application/ld+json" is:inline set:html={JSON.stringify(block)} />
))}
