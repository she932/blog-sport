---
// En-tête de page réutilisable (pages listes + pages statiques).
// Bandeau léger DA : dégradé orange clair -> fond, eyebrow orange, H1, chapô.
// `narrow` aligne le contenu sur la largeur de lecture (pages texte).
interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
  narrow?: boolean;
}
const { title, eyebrow, lead, narrow = false } = Astro.props;
---

<section class="page-hero">
  <div class:list={['container', { narrow }]}>
    {eyebrow && <span class="page-eyebrow">{eyebrow}</span>}
    <h1>{title}</h1>
    {lead && <p class="page-lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    background: linear-gradient(180deg, var(--color-accent-soft), transparent);
    border-bottom: 1px solid var(--color-border);
    padding: clamp(2.4rem, 5vw, 3.4rem) 0 clamp(1.6rem, 3vw, 2.2rem);
  }
  .container.narrow {
    max-width: var(--content-w);
  }
  .page-eyebrow {
    display: inline-block;
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent-dark);
    margin-bottom: 0.4rem;
  }
  .page-hero h1 {
    margin: 0.2rem 0 0.6rem;
    font-size: clamp(1.9rem, 4vw, 2.7rem);
    letter-spacing: -0.01em;
  }
  .page-lead {
    color: var(--color-muted);
    font-size: 1.15rem;
    line-height: 1.6;
    max-width: 62ch;
    margin: 0;
  }
</style>
