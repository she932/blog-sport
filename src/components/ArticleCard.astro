---
import { CATEGORIES } from '../consts';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const cat = CATEGORIES.find((c) => c.slug === post.data.category);
const url = `${base}/blog/${post.id}`;
const dateStr = post.data.pubDate.toLocaleDateString('fr-FR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<article class:list={['card', { 'card--featured': featured }]}>
  <a href={url} class="card-link" aria-label={post.data.title}></a>
  <div class="card-body">
    {cat && <span class="badge">{cat.name}</span>}
    <h3 class="card-title">{post.data.title}</h3>
    <p class="card-desc">{post.data.description}</p>
    <div class="card-meta">
      <time datetime={post.data.pubDate.toISOString()}>{dateStr}</time>
      {post.data.readingTime && <span>· {post.data.readingTime} min de lecture</span>}
    </div>
  </div>
</article>

<style>
  .card {
    position: relative;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--mg-shadow);
    transition: transform 0.18s ease, box-shadow 0.18s ease,
      border-color 0.18s ease;
    display: flex;
    flex-direction: column;
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: var(--mg-shadow-hover);
    border-color: color-mix(in srgb, var(--color-accent) 45%, var(--color-border));
  }
  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }
  }
  .card-link {
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .card-body {
    padding: 1.3rem 1.4rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
  }
  .card-title {
    margin: 0.2rem 0 0;
    font-size: 1.2rem;
    line-height: 1.3;
  }
  .card--featured .card-title {
    font-size: 1.55rem;
  }
  .card-desc {
    color: var(--color-muted);
    font-size: 0.95rem;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-meta {
    margin-top: auto;
    color: var(--color-muted);
    font-size: 0.82rem;
    display: flex;
    gap: 0.4rem;
    padding-top: 0.4rem;
  }
</style>
