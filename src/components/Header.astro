---
import { SITE, CATEGORIES } from '../consts';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === `${base}/` ? path === href : path.startsWith(href);
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={`${base}/`} aria-label={SITE.title}>
      <span class="brand-bar" aria-hidden="true"></span>
      <span class="brand-name">Muscu<span class="brand-name-accent">Guide</span></span>
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-nav"
      aria-label="Ouvrir le menu"
    >
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
    </button>

    <nav class="nav" id="primary-nav" aria-label="Navigation principale">
      {CATEGORIES.map((c) => (
        <a
          href={`${base}/categorie/${c.slug}/`}
          class:list={['nav-link', { active: isActive(`${base}/categorie/${c.slug}/`) }]}
        >
          {c.name}
        </a>
      ))}
      <a href={`${base}/blog/`} class:list={['nav-link', { active: isActive(`${base}/blog/`) }]}>
        Tous les articles
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--mg-navy) 92%, transparent);
    backdrop-filter: saturate(160%) blur(10px);
    -webkit-backdrop-filter: saturate(160%) blur(10px);
    border-bottom: 1px solid var(--mg-navy-line);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 64px;
  }

  /* ---------- Marque (barre orange + texte bi-ton) ---------- */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }
  .brand:hover {
    text-decoration: none;
  }
  .brand-bar {
    width: 10px;
    height: 26px;
    border-radius: 3px;
    background: var(--mg-orange);
  }
  .brand-name {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--mg-white);
    line-height: 1;
  }
  .brand-name-accent {
    color: var(--mg-orange);
  }

  /* ---------- Navigation (desktop) ---------- */
  .nav {
    display: flex;
    gap: 0.4rem 1.4rem;
    align-items: center;
  }
  .nav-link {
    color: var(--mg-on-navy);
    font-weight: 600;
    font-size: 0.875rem;
    white-space: nowrap;
    padding: 0.4em 0;
    transition: color 0.18s ease;
  }
  .nav-link:hover {
    color: var(--mg-white);
    text-decoration: none;
  }
  .nav-link.active {
    color: var(--mg-orange);
    text-decoration: none;
  }

  /* ---------- Bouton hamburger (mobile) ---------- */
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 0;
    background: transparent;
    border: none;
    cursor: pointer;
  }
  .nav-toggle-bar {
    display: block;
    width: 24px;
    height: 2.5px;
    margin: 0 auto;
    border-radius: 2px;
    background: var(--mg-white);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle-bar:nth-child(1) {
    transform: translateY(7.5px) rotate(45deg);
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle-bar:nth-child(2) {
    opacity: 0;
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle-bar:nth-child(3) {
    transform: translateY(-7.5px) rotate(-45deg);
  }

  /* ---------- Bascule mobile (breakpoint DA : 1040px) ---------- */
  @media (max-width: 1040px) {
    .nav-toggle {
      display: flex;
    }
    .nav {
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0.4rem 0 0.85rem;
      background: var(--mg-navy);
      border-bottom: 1px solid var(--mg-navy-line);
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      pointer-events: none;
      transition: max-height 0.25s ease, opacity 0.2s ease;
    }
    .site-header.nav-open .nav {
      max-height: 80vh;
      opacity: 1;
      pointer-events: auto;
    }
    .nav-link {
      padding: 0.85em 20px;
      font-size: 0.95rem;
      color: var(--mg-white);
      border-bottom: 1px solid var(--mg-navy-line);
    }
    .nav-link:last-child {
      border-bottom: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav,
    .nav-toggle-bar {
      transition: none;
    }
  }
</style>

<script>
  const header = document.querySelector('.site-header');
  const toggle = header?.querySelector('.nav-toggle');

  if (header && toggle) {
    const setOpen = (open: boolean) => {
      header.classList.toggle('nav-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
    };

    toggle.addEventListener('click', () => {
      setOpen(!header.classList.contains('nav-open'));
    });

    header.querySelectorAll('.nav-link').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });
    const mq = window.matchMedia('(min-width: 1041px)');
    mq.addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
  }
</script>
