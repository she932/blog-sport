---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import '../styles/product-fiche.css';
import BaseLayout from './BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { SITE, CATEGORIES } from '../consts';
import { AFFILIATE_DISCLOSURE } from '../lib/affiliate';
import { slugifyTag } from '../lib/slug';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { data } = post;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const cat = CATEGORIES.find((c) => c.slug === data.category);

// --- Articles liés (maillage interne) --------------------------
// Pertinence par tags : score = nombre de tags en commun avec l'article
// courant, tri par score décroissant puis date décroissante. Si moins de
// 3 articles pertinents (score > 0), on complète avec les plus récents de
// la même catégorie. Purement build-time, aucune dépendance à l'automatisation.
const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
const currentTags = new Set(data.tags);
const candidates = allPosts.filter((p) => p.id !== post.id);
const scored = candidates
  .map((p) => ({
    post: p,
    score: p.data.tags.reduce((n, t) => n + (currentTags.has(t) ? 1 : 0), 0),
  }))
  .filter((s) => s.score > 0)
  .sort(
    (a, b) =>
      b.score - a.score ||
      b.post.data.pubDate.getTime() - a.post.data.pubDate.getTime()
  );
let related = scored.slice(0, 3).map((s) => s.post);
// Complément : plus récents de la même catégorie si moins de 3 résultats.
if (related.length < 3) {
  const already = new Set([post.id, ...related.map((p) => p.id)]);
  const fillers = candidates.filter(
    (p) => !already.has(p.id) && p.data.category === data.category
  );
  related = [...related, ...fillers].slice(0, 3);
}

// Nombre d'articles par slug de tag : un tag n'est cliquable que si sa page
// d'archive existe (seuil ≥ 2 dans src/pages/tag/[tag].astro), sinon on
// afficherait un lien cassé. Les autres tags restent visibles, non cliquables.
const tagCounts = new Map<string, number>();
for (const p of allPosts) {
  const seen = new Set<string>();
  for (const t of p.data.tags) {
    const slug = slugifyTag(t);
    if (!slug || seen.has(slug)) continue;
    seen.add(slug);
    tagCounts.set(slug, (tagCounts.get(slug) ?? 0) + 1);
  }
}
const hasTagPage = (t: string) => (tagCounts.get(slugifyTag(t)) ?? 0) >= 2;

const canonical = new URL(`${base}/blog/${post.id}`, Astro.site).toString();
const dateStr = data.pubDate.toLocaleDateString('fr-FR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

// --- Données structurées ---------------------------------------
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.description,
  image: [new URL(data.heroImage ?? `${base}/og-default.png`, Astro.site).toString()],
  datePublished: data.pubDate.toISOString(),
  dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
  author: { '@type': 'Organization', name: data.author },
  publisher: {
    '@type': 'Organization',
    name: SITE.title,
    logo: {
      '@type': 'ImageObject',
      url: new URL(`${base}/favicon.svg`, Astro.site).toString(),
    },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  keywords: data.tags.join(', '),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: new URL(`${base}/`, Astro.site).toString() },
    cat && {
      '@type': 'ListItem',
      position: 2,
      name: cat.name,
      item: new URL(`${base}/categorie/${cat.slug}`, Astro.site).toString(),
    },
    { '@type': 'ListItem', position: 3, name: data.title, item: canonical },
  ].filter(Boolean),
};

const faqLd =
  data.faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: data.faq.map((f) => ({
          '@type': 'Question',
          name: f.question,
          acceptedAnswer: { '@type': 'Answer', text: f.answer },
        })),
      }
    : null;

const jsonLd = [articleLd, breadcrumbLd, faqLd].filter(Boolean) as Record<
  string,
  unknown
>[];
---

<BaseLayout
  title={data.title}
  description={data.description}
  type="article"
  image={data.heroImage}
  publishedTime={data.pubDate}
  modifiedTime={data.updatedDate ?? data.pubDate}
  jsonLd={jsonLd}
>
  <article class="post">
    <div class="container post-head">
      <nav class="breadcrumb" aria-label="Fil d'Ariane">
        <a href={`${base}/`}>Accueil</a>
        {cat && (<><span>/</span><a href={`${base}/categorie/${cat.slug}`}>{cat.name}</a></>)}
      </nav>
      {cat && <span class="badge">{cat.name}</span>}
      <h1>{data.title}</h1>
      <p class="lead">{data.description}</p>
      <div class="post-meta">
        <span>Par {data.author}</span>
        <span>·</span>
        <time datetime={data.pubDate.toISOString()}>{dateStr}</time>
        {data.readingTime && (<><span>·</span><span>{data.readingTime} min de lecture</span></>)}
      </div>
    </div>

    <div class="container prose-wrap">
      <div class="disclosure-inline">{AFFILIATE_DISCLOSURE}</div>
      <div class="prose">
        <slot />
      </div>

      {data.faq.length > 0 && (
        <section class="faq" aria-labelledby="faq-title">
          <h2 id="faq-title">Questions fréquentes</h2>
          {data.faq.map((f) => (
            <details class="faq-item">
              <summary>{f.question}</summary>
              <p>{f.answer}</p>
            </details>
          ))}
        </section>
      )}

      {data.tags.length > 0 && (
        <div class="tags">
          {data.tags.map((t) =>
            hasTagPage(t) ? (
              <a class="tag" href={`${base}/tag/${slugifyTag(t)}`}>#{t}</a>
            ) : (
              <span class="tag tag--static">#{t}</span>
            )
          )}
        </div>
      )}
    </div>

    {related.length > 0 && (
      <aside class="container related" aria-labelledby="related-title">
        <span class="eyebrow">À lire aussi</span>
        <h2 id="related-title" class="related-title">Sur le même thème</h2>
        <div class="related-grid">
          {related.map((p) => <ArticleCard post={p} />)}
        </div>
      </aside>
    )}
  </article>
</BaseLayout>

<style is:global>
  /* ---------- Encadrés & boutons affiliés (injectés dans le markdown) ---------- */
  .affiliate-box {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.8rem;
    background: linear-gradient(
      180deg,
      var(--color-accent-soft),
      var(--color-surface) 85%
    );
    border: 1px solid color-mix(in srgb, var(--color-accent) 22%, var(--color-border));
    border-radius: var(--mg-radius-lg);
    padding: 1.5rem 1.6rem 1.5rem 1.9rem;
    margin: 2.4rem 0;
    box-shadow: var(--mg-shadow);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .affiliate-box::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 6px;
    border-radius: var(--mg-radius-lg) 0 0 var(--mg-radius-lg);
    background: linear-gradient(
      180deg,
      var(--color-accent),
      var(--color-accent-dark)
    );
  }
  .affiliate-box:hover {
    transform: translateY(-3px);
    box-shadow: var(--mg-shadow-hover);
  }
  .affiliate-box .aff-info {
    flex: 1 1 240px;
  }
  .affiliate-box .aff-label {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-accent-dark);
    background: color-mix(in srgb, var(--color-accent) 14%, transparent);
    padding: 0.28em 0.65em;
    border-radius: 999px;
  }
  .affiliate-box .aff-label::before {
    content: '★';
    font-size: 0.9em;
    line-height: 1;
  }
  .affiliate-box .aff-name {
    display: block;
    font-weight: 800;
    font-size: 1.2rem;
    line-height: 1.3;
    margin: 0.6rem 0 0.35rem;
    color: var(--color-dark);
  }
  .affiliate-box .aff-desc {
    font-size: 0.92rem;
    color: var(--color-muted);
    margin: 0;
  }
  .affiliate-box .aff-cta {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
  }
  .aff-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    background: linear-gradient(
      180deg,
      var(--mg-orange-hover),
      var(--color-accent) 55%,
      var(--color-accent-dark)
    );
    color: #fff !important;
    padding: 0.92em 1.7em;
    border-radius: 999px;
    font-weight: 800;
    font-size: 1.02rem;
    white-space: nowrap;
    box-shadow: 0 4px 14px rgba(232, 87, 31, 0.35);
    transition: transform 0.15s ease, box-shadow 0.15s ease, filter 0.15s ease;
  }
  .aff-btn:hover {
    text-decoration: none;
    transform: translateY(-1px);
    filter: brightness(1.05);
    box-shadow: 0 6px 20px rgba(232, 87, 31, 0.45);
  }
  .aff-btn-arrow {
    transition: transform 0.15s ease;
  }
  .aff-btn:hover .aff-btn-arrow {
    transform: translateX(3px);
  }
  .aff-note {
    font-size: 0.72rem;
    color: var(--color-muted);
  }
  a.aff-inline {
    font-weight: 600;
    color: var(--color-accent-dark);
    border-bottom: 1px solid color-mix(in srgb, var(--color-accent) 45%, transparent);
    transition: border-color 0.15s ease;
  }
  a.aff-inline:hover {
    text-decoration: none;
    border-bottom-color: var(--color-accent);
  }

  /* ---------- Chantier n°2 : encadré enrichi (optionnel) ----------
     Ces règles ne s'appliquent que si le produit possède image / note /
     prix dans data/products.json. Sans métadonnée, l'encadré minimal
     n'est pas affecté. */
  .affiliate-box--media {
    align-items: stretch;
  }
  .aff-media {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 104px;
    padding: 6px;
    background: #fff;
    border-radius: 12px;
    border: 1px solid var(--color-border);
  }
  .aff-media img {
    width: 100%;
    height: auto;
    max-height: 104px;
    object-fit: contain;
    mix-blend-mode: multiply;
  }
  .aff-rating {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
    margin: 0.15rem 0;
    font-size: 0.86rem;
  }
  .aff-stars {
    position: relative;
    display: inline-block;
    white-space: nowrap;
    line-height: 1;
    letter-spacing: 1px;
    color: color-mix(in srgb, var(--color-border) 60%, var(--color-muted));
  }
  .aff-stars .aff-stars-fill {
    position: absolute;
    left: 0;
    top: 0;
    width: var(--pct, 0%);
    overflow: hidden;
    white-space: nowrap;
    color: var(--mg-gold);
  }
  .aff-rating-num {
    font-weight: 800;
    color: var(--color-dark);
  }
  .aff-reviews {
    color: var(--color-muted);
  }
  .aff-price {
    font-weight: 800;
    font-size: 1.02rem;
    color: var(--color-dark);
  }
  .aff-price-asof {
    font-weight: 600;
    font-size: 0.72rem;
    color: var(--color-muted);
  }
  .aff-prime {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    color: #0a7ea4;
    background: color-mix(in srgb, #0a7ea4 12%, transparent);
    padding: 0.2em 0.6em;
    border-radius: 999px;
  }
  .aff-prime::before {
    content: "✓";
    font-weight: 900;
  }

  @media (max-width: 560px) {
    .affiliate-box .aff-cta {
      align-items: stretch;
      width: 100%;
    }
    .aff-btn {
      justify-content: center;
    }
    .affiliate-box--media {
      flex-wrap: wrap;
    }
    .aff-media {
      width: 76px;
    }
  }
</style>

<style>
  .post-head {
    max-width: var(--content-w);
    padding-top: 2.5rem;
  }
  .breadcrumb {
    display: flex;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-muted);
    margin-bottom: 1rem;
  }
  .breadcrumb a {
    color: var(--color-muted);
    transition: color 0.15s ease;
  }
  .breadcrumb a:hover {
    color: var(--color-accent-dark);
    text-decoration: none;
  }
  .post-head h1 {
    margin: 0.7rem 0 0.6rem;
    font-size: clamp(2rem, 4.4vw, 3rem);
    letter-spacing: -0.01em;
  }
  .lead {
    font-size: 1.22rem;
    line-height: 1.6;
    color: var(--color-muted);
    margin: 0 0 1.2rem;
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    color: var(--color-muted);
    font-size: 0.9rem;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 1.4rem;
  }
  .prose-wrap {
    max-width: var(--content-w);
  }
  .disclosure-inline {
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--color-muted);
    background: var(--color-accent-soft);
    border: 1px solid color-mix(in srgb, var(--color-accent) 18%, var(--color-border));
    border-left: 4px solid var(--color-accent);
    border-radius: 0 var(--mg-radius-sm) var(--mg-radius-sm) 0;
    padding: 0.8rem 1.1rem;
    margin: 1.8rem 0;
  }
  .prose :global(h2) {
    border-top: 1px solid var(--color-border);
    padding-top: 1.6rem;
    margin-top: 2.2rem;
  }
  .prose :global(p),
  .prose :global(li) {
    color: var(--color-text);
  }
  .prose :global(strong) {
    color: var(--color-dark);
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.3rem;
  }
  .prose :global(li) {
    margin-bottom: 0.4rem;
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.6rem 0;
    font-size: 0.95rem;
    display: block;
    overflow-x: auto;
  }
  .prose :global(th),
  .prose :global(td) {
    border: 1px solid var(--color-border);
    padding: 0.6em 0.8em;
    text-align: left;
  }
  .prose :global(th) {
    background: var(--color-surface);
    font-weight: 700;
  }
  .prose :global(blockquote) {
    margin: 1.6rem 0;
    padding: 0.6rem 1.2rem;
    border-left: 4px solid var(--color-accent);
    background: var(--color-accent-soft);
    border-radius: 0 8px 8px 0;
    color: var(--color-text);
  }
  .prose :global(img) {
    border-radius: var(--radius);
    margin: 1.6rem 0;
  }

  .faq {
    margin-top: 3rem;
  }
  .faq-item {
    border: 1px solid var(--color-border);
    border-radius: var(--mg-radius-sm);
    padding: 0.4rem 1.2rem;
    margin-bottom: 0.75rem;
    background: var(--color-surface);
    box-shadow: var(--mg-shadow);
    transition: border-color 0.15s ease;
  }
  .faq-item[open] {
    border-color: color-mix(in srgb, var(--color-accent) 40%, var(--color-border));
  }
  .faq-item summary {
    cursor: pointer;
    font-weight: 700;
    padding: 0.7rem 0;
    color: var(--color-dark);
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item summary::after {
    content: '+';
    color: var(--color-accent);
    font-weight: 800;
    font-size: 1.4rem;
    line-height: 1;
    transition: transform 0.18s ease;
  }
  .faq-item[open] summary::after {
    transform: rotate(45deg);
  }
  .faq-item p {
    margin: 0 0 0.9rem;
    color: var(--color-text);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2.5rem;
  }
  .tag {
    font-size: 0.82rem;
    color: var(--color-muted);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 0.32em 0.75em;
    border-radius: 999px;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  a.tag:hover {
    color: var(--color-accent-dark);
    border-color: color-mix(in srgb, var(--color-accent) 45%, var(--color-border));
    text-decoration: none;
  }
  .tag--static {
    cursor: default;
  }

  /* ---------- Articles liés (maillage interne) ---------- */
  .related {
    margin-top: clamp(3rem, 5vw, 4.5rem);
    padding-top: 2.4rem;
    border-top: 1px solid var(--color-border);
  }
  .eyebrow {
    display: inline-block;
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent-dark);
    margin-bottom: 0.35rem;
  }
  .related-title {
    margin: 0 0 1.4rem;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--mg-space-grid);
  }
  @media (max-width: 900px) {
    .related-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
