---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Page introuvable" description="Cette page n'existe pas." noindex>
  <div class="container center">
    <span class="ghost" aria-hidden="true">404</span>
    <span class="eyebrow">Erreur 404</span>
    <h1>Cette page a pris sa journée de repos 🏋️</h1>
    <p>La page que vous cherchez est introuvable ou a été déplacée.</p>
    <div class="cta">
      <a class="btn" href={`${base}/`}>Retour à l'accueil</a>
      <a class="btn hero-ghost" href={`${base}/blog`}>Voir les articles</a>
    </div>
  </div>
</BaseLayout>

<style>
  .center {
    position: relative;
    text-align: center;
    padding: clamp(4rem, 9vw, 7rem) 0;
    max-width: 52ch;
    margin: 0 auto;
  }
  .ghost {
    display: block;
    font-size: clamp(6rem, 20vw, 11rem);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.03em;
    color: var(--color-accent);
    opacity: 0.12;
    margin-bottom: -0.4em;
  }
  .eyebrow {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent-dark);
  }
  .center h1 {
    margin: 0.6rem 0 0.6rem;
  }
  .center p {
    color: var(--color-muted);
    margin-bottom: 1.8rem;
  }
  .cta {
    display: flex;
    gap: 0.8rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  /* variante ghost sur fond clair */
  .hero-ghost {
    background: transparent;
    color: var(--color-accent-dark);
    border: 2px solid var(--color-accent);
  }
  .hero-ghost:hover {
    background: var(--color-accent-soft);
  }
</style>
