---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Page introuvable" description="Cette page n'existe pas." noindex>
  <div class="container center">
    <span class="badge">Erreur 404</span>
    <h1>Cette page a pris sa journée de repos 🏋️</h1>
    <p>La page que vous cherchez est introuvable ou a été déplacée.</p>
    <a class="btn" href={`${base}/`}>Retour à l'accueil</a>
  </div>
</BaseLayout>

<style>
  .center {
    text-align: center;
    padding: 5rem 0;
    max-width: 46ch;
  }
  .center h1 {
    margin: 1rem 0 0.6rem;
  }
  .center p {
    color: var(--color-muted);
    margin-bottom: 1.6rem;
  }
</style>
