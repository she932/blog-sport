---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import PageHero from '../../components/PageHero.astro';
import { slugifyTag } from '../../lib/slug';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);

  // Regroupe les articles par slug de tag (fusionne les variantes
  // accentuées/casse). On conserve un libellé d'affichage représentatif
  // (première occurrence rencontrée).
  const groups = new Map<
    string,
    { label: string; posts: CollectionEntry<'blog'>[] }
  >();

  for (const post of posts) {
    const seen = new Set<string>();
    for (const tag of post.data.tags) {
      const slug = slugifyTag(tag);
      if (!slug || seen.has(slug)) continue; // évite les doublons intra-article
      seen.add(slug);
      const group = groups.get(slug);
      if (group) {
        group.posts.push(post);
      } else {
        groups.set(slug, { label: tag, posts: [post] });
      }
    }
  }

  // Seuil ≥ 2 : on ne génère pas de page pour un tag à un seul article
  // (évite les pages d'archive « minces », mal valorisées en SEO). La page
  // apparaîtra automatiquement dès qu'un 2ᵉ article portera ce tag.
  return [...groups.entries()]
    .filter(([, { posts: tagged }]) => tagged.length >= 2)
    .map(([slug, { label, posts: tagged }]) => ({
      params: { tag: slug },
      props: {
        label,
        posts: tagged.sort(
          (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
        ),
      },
    }));
}

interface Props {
  label: string;
  posts: CollectionEntry<'blog'>[];
}

const { label, posts } = Astro.props;
const title = `#${label}`;
const description = `Tous nos articles sur le thème « ${label} » : guides, comparatifs et conseils MuscuGuide pour bien s'équiper et progresser.`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title={title} description={description}>
  <PageHero eyebrow="Tag" title={title} lead={description}>
    <a class="tag-back" href={`${base}/blog/`}>← Tous les articles</a>
  </PageHero>

  <div class="container section">
    {posts.length > 0 ? (
      <div class="grid">
        {posts.map((p) => <ArticleCard post={p} />)}
      </div>
    ) : (
      <p class="empty">Aucun article sur ce thème pour le moment.</p>
    )}
  </div>
</BaseLayout>

<style>
  .tag-back {
    display: inline-block;
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--color-accent-dark);
  }
  .section {
    padding-top: clamp(2rem, 4vw, 2.8rem);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--mg-space-grid);
  }
  .empty {
    color: var(--color-muted);
    padding: 3rem 0;
    text-align: center;
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
