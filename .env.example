# ============================================================
#  Variables d'environnement du blog
#  Copiez ce fichier en `.env` pour le développement local.
#  En production (GitHub Actions), définissez-les dans
#  Settings > Secrets and variables > Actions.
# ============================================================

# Clé API Anthropic (obligatoire pour générer les articles)
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Votre identifiant Partenaire Amazon (Amazon Associates)
# Exemple : muscuguide-21
AMAZON_AFFILIATE_TAG=muscuguide-21

# Domaine Amazon utilisé pour les liens affiliés
AMAZON_DOMAIN=amazon.fr

# Modèle Claude utilisé pour la rédaction
ANTHROPIC_MODEL=claude-sonnet-5
